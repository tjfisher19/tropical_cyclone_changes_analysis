@article{Knutson2015,
   abstract = {AbstractGlobal projections of intense tropical cyclone activity are derived from the Geophysical Fluid Dynamics Laboratory (GFDL) HiRAM (50 km grid) atmospheric model and the GFDL Hurricane Model using a two-stage downscaling procedure. First, tropical cyclone genesis is simulated globally using the HiRAM atmospheric model. Each storm is then downscaled into the GFDL Hurricane Model, with horizontal grid-spacing near the storm of 6 km, and including ocean coupling (e.g., â~@~Xcold wakeâ~@~Y generation). Simulations are performed using observed sea surface temperatures (SSTs) (1980-2008); for a â~@~\control runâ~@~] with 20 repeating seasonal cycles; and for a late 21st century projection using an altered SST seasonal cycle obtained from a CMIP5/RCP4.5 multi-model ensemble. In general agreement with most previous studies, projections with this framework indicate fewer tropical cyclones globally in a warmer late-21st-century climate, but also an increase in average cyclone intensity, precipitation rates, and in the number ...},
   author = {Thomas R. Knutson and Joseph J. Sirutis and Ming Zhao and Robert E. Tuleya and Morris Bender and Gabriel A. Vecchi and Gabriele Villarini and Daniel Chavas},
   doi = {10.1175/JCLI-D-15-0129.1},
   issn = {0894-8755},
   issue = {18},
   journal = {Journal of Climate},
   month = {9},
   pages = {7203-7224},
title = {Global {P}rojections of {I}ntense {T}ropical {C}yclone {A}ctivity for the {L}ate {T}wenty-{F}irst {C}entury from {D}ynamical {D}ownscaling of {CMIP5/RCP4.5} {S}cenarios},
   volume = {28},
   year = {2015}
}
@article{Bhatia2019,
   abstract = {Tropical cyclones that rapidly intensify are typically associated with the highest forecast errors and cause a disproportionate amount of human and financial losses. Therefore, it is crucial to understand if, and why, there are observed upward trends in tropical cyclone intensification rates. Here, we utilize two observational datasets to calculate 24-hour wind speed changes over the period 1982â~@~S2009. We compare the observed trends to natural variability in bias-corrected, high-resolution, global coupled model experiments that accurately simulate the climatological distribution of tropical cyclone intensification. Both observed datasets show significant increases in tropical cyclone intensification rates in the Atlantic basin that are highly unusual compared to model-based estimates of internal climate variations. Our results suggest a detectable increase of Atlantic intensification rates with a positive contribution from anthropogenic forcing and reveal a need for more reliable data before detecting a robust trend at the global scale.},
   author = {Kieran T. Bhatia and Gabriel A. Vecchi and Thomas R. Knutson and Hiroyuki Murakami and James Kossin and Keith W. Dixon and Carolyn E. Whitlock},
   doi = {10.1038/s41467-019-08471-z},
   issn = {20411723},
   issue = {1},
   journal = {Nature Communications},
   pages = {1-9},
   publisher = {Springer US},
   title = {Recent increases in tropical cyclone intensification rates},
   volume = {10},
   year = {2019}
}
